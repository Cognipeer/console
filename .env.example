# ============================================================
# Cognipeer Console — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
# All variables have sensible defaults unless marked (required).
# ============================================================

# ---- Storage -------------------------------------------------
# DATA_DIR=./data                                   # Root directory for built-in on-disk data (vector indexes, file storage). Docker image defaults to /app/data.

# ---- Database ------------------------------------------------
# Provider: sqlite (default, zero-dependency) | mongodb
DB_PROVIDER=sqlite                                 # Database backend
MAIN_DB_NAME=console_main                          # Main database name
SQLITE_DATA_DIR=./data/sqlite                      # SQLite data directory

# MongoDB (only required when DB_PROVIDER=mongodb)
# MONGODB_URI=mongodb://localhost:27017             # MongoDB connection string
# MONGODB_MIN_POOL_SIZE=2                           # Minimum connection pool size
# MONGODB_MAX_POOL_SIZE=10                          # Maximum connection pool size
# MONGODB_CONNECT_TIMEOUT_MS=10000                  # Connection timeout (ms)
# MONGODB_SOCKET_TIMEOUT_MS=45000                   # Socket timeout (ms)
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000          # Server selection timeout (ms)
# MONGODB_SINGLE_DATABASE=                          # true|false. Keep tenant collections in MAIN_DB_NAME instead of a
#                                                    # separate tenant_{slug} database. Defaults to true when
#                                                    # DEPLOYMENT_MODE=onprem (below), false otherwise. On-prem deployments
#                                                    # are single-organization, so this is safe; a second tenant is refused.

# ---- Authentication ------------------------------------------
JWT_SECRET=                                        # (required) JWT signing secret — min 32 random chars (e.g. `openssl rand -hex 32`)
JWT_EXPIRES_IN=7d                                  # Token expiry (1d, 7d, 30d)
PROVIDER_ENCRYPTION_SECRET=                        # (required) Independent encryption key for provider credentials — min 32 chars, MUST differ from JWT_SECRET

# ---- Registration --------------------------------------------
# REGISTRATION_MODE=open                            # open | beta | disabled. 'beta' requires a beta access code on signup
#                                                   # (seed codes with `npm run seed:beta-codes -- --count 10`).
#                                                   # 'disabled' turns public signup off (on-prem; pair with BOOTSTRAP_* below).
# On-prem bootstrap: on first boot, when no organization exists yet, create a
# single organization owned by this user. All three must be set together.
# BOOTSTRAP_ORG_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Administrator

# ---- Deployment ----------------------------------------------
# saas | onprem. Defaults to 'onprem' when DB_PROVIDER=sqlite, otherwise 'saas'.
# Set it explicitly when the inferred value is wrong (e.g. on-prem on MongoDB).
# DEPLOYMENT_MODE=

# ---- Cognipeer Support ---------------------------------------
# On SaaS the Help & Support entry points appear only when all three values are
# set, so a click can never end in a 503.
# SUPPORT_HANDOFF_SECRET must be at least 32 characters and must equal CRM's
# SUPPORT_HANDOFF_SECRET_CONSOLE. It is server-only — never use NEXT_PUBLIC_.
# On-prem: SUPPORT_BASE_URL alone is enough; Console then sends the user to the
# Support login page instead of failing.
# SUPPORT_BASE_URL=https://support.cognipeer.com
# SUPPORT_CRM_API_URL=
# SUPPORT_HANDOFF_SECRET=

# ---- License -------------------------------------------------
# Free license is built in and allows 2 projects. Paid offline licenses are
# signed outside the app with the private key and verified here with the public key.
# OFFLINE_LICENSE_PUBLIC_KEY_PATH=./offline-license/public.pem
# OFFLINE_LICENSE_PUBLIC_KEY=                       # PEM content; use \n escapes for multiline env values
# OFFLINE_LICENSE_ISSUER=cognipeer
# OFFLINE_LICENSE_AUDIENCE=cognipeer-console
#
# Enterprise gating is always enforced at runtime (no effect in the community
# edition — the enterprise routes don't exist there). Tenants activate their
# license via /dashboard/license; there is no env-based license.
# LICENSE_GRACE_DAYS=14                              # days past expiry an ENTERPRISE license still activates (with a warning)

# ---- Email (SMTP) --------------------------------------------
# Optional — emails will be skipped if not configured
# SMTP_HOST=smtp.example.com                        # SMTP server hostname
# SMTP_PORT=587                                     # SMTP port
# SMTP_SECURE=false                                 # Use TLS (true/false)
# SMTP_USER=                                        # SMTP username
# SMTP_PASS=                                        # SMTP password
# SMTP_FROM=noreply@example.com                     # Sender address (defaults to SMTP_USER)
# Or use SendGrid SMTP with an API key. SMTP_* settings take precedence when set.
# SENDGRID_API_KEY=                                  # SendGrid API key
# SENDGRID_FROM_EMAIL=noreply@example.com            # Verified SendGrid sender address

# ---- Gateway / Resilience ------------------------------------
# GATEWAY_REQUEST_TIMEOUT_MS=120000                 # Per-attempt timeout for provider calls (ms); a retry gets the full budget again. 0 disables
# GATEWAY_RETRY_ENABLED=true                        # Enable retry on provider failures
# GATEWAY_RETRY_MAX_ATTEMPTS=3                      # Max retry attempts (1 = no retry)
# GATEWAY_RETRY_INITIAL_DELAY_MS=200                # Initial retry delay (exponential backoff)
# GATEWAY_CIRCUIT_BREAKER_ENABLED=true              # Enable circuit breaker
# GATEWAY_CIRCUIT_BREAKER_THRESHOLD=5               # Failures to trip the breaker
# GATEWAY_CIRCUIT_BREAKER_RESET_MS=30000            # Time before half-open reset (ms)

# ---- Cache ---------------------------------------------------
# Provider: none | memory | redis
CACHE_PROVIDER=memory                              # Cache provider (no fallback)
# CACHE_TTL_SECONDS=300                             # Default cache TTL (seconds)
# REDIS_URL=                                        # Redis connection URL (required when redis)
# REDIS_KEY_PREFIX=console:                         # Redis key prefix

# ---- Rate Limiting -------------------------------------------
# Provider: mongodb (default) | memory | redis
# memory/redis providers use the active cache provider; set CACHE_PROVIDER to the same value.
RATE_LIMIT_PROVIDER=memory                         # Rate limit backend
# RATE_LIMIT_SYNC_INTERVAL_MS=5000                  # Sync interval for distributed counters
#
# The tenant license + quota policies behind a limit check are cached for this
# long (policy edits through the API invalidate it immediately). 0 disables the
# cache and every guarded request re-reads both from the database.
# QUOTA_POLICY_CACHE_TTL_SECONDS=30                 # Quota policy cache TTL (seconds)

# ---- Logging -------------------------------------------------
# LOG_LEVEL=debug                                   # error | warn | info | debug
# LOG_FORMAT=pretty                                 # json | pretty (pretty = colorized dev output)
# LOG_REQUEST_BODY=false                            # Log request bodies (caution: sensitive data)
# LOG_RESPONSE_BODY=false                           # Log response bodies

# ---- CORS ----------------------------------------------------
# CORS_ENABLED=false                                # Enable CORS for /api/client/* endpoints
# CORS_ALLOWED_ORIGINS=                             # Comma-separated origins (required when CORS enabled)
# CORS_MAX_AGE=86400                                # Preflight cache max-age (seconds)

# ---- Health ---------------------------------------------------
# HEALTH_ENDPOINT_ENABLED=true                      # Enable /api/health/live and /api/health/ready

# ---- Limits --------------------------------------------------
# NEXT_BODY_SIZE_LIMIT=10mb                         # Max body size for server actions
# TRACING_MAX_BODY_SIZE_MB=10                       # Max tracing session payload (MB)
# FILE_UPLOAD_MAX_MB=50                             # Max single file upload size (MB)
# FILE_UPLOAD_ALLOWED_MIME_TYPES=                   # Comma-separated MIME allowlist; supports "image/*". Empty = allow any.

# ---- Application ---------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000                       # Server public URL (used in emails, links)
# NEXT_PUBLIC_APP_URL=http://localhost:3000         # Legacy fallback; prefer APP_URL for server configuration
# SHUTDOWN_TIMEOUT_MS=15000                         # Graceful shutdown timeout (ms)

# ---- Provider Runtime Pool -----------------------------------
# PROVIDER_RUNTIME_CACHE_TTL_SECONDS=300            # SDK client cache TTL (0 = no caching)
# An evicted runtime keeps its connections (pg pool, Elasticsearch client) for
# this long before they are closed, so a request still holding it can finish.
# 0 closes immediately.
# PROVIDER_RUNTIME_DISPOSE_GRACE_SECONDS=300        # Grace before an evicted runtime's connections close

# ---- Browser Runtime -----------------------------------------
# BROWSER_DEFAULT_MAX_CONCURRENT=10                 # Default concurrent browser sessions per tenant
# BROWSER_DEFAULT_IDLE_TIMEOUT_MS=300000            # Auto-close idle sessions after this many ms
# BROWSER_DEFAULT_MAX_LIFETIME_MS=1800000           # Hard session lifetime cap in ms
# BROWSER_HEADLESS=true                             # Launch Chromium in headless mode
# BROWSER_VIEWPORT_WIDTH=1280                       # Default viewport width
# BROWSER_VIEWPORT_HEIGHT=800                       # Default viewport height
# BROWSER_REAPER_INTERVAL_MS=30000                  # Idle-session sweep interval
# BROWSER_DEFAULT_ARTIFACT_BUCKET=browser-artifacts # Default artifact bucket key
# BROWSER_BLOCK_PRIVATE_NETWORK=true                # Block localhost/private network browser egress

# ---- JS Sandbox Runtime --------------------------------------
# JS_SANDBOX_DEFAULT_MAX_CONCURRENT=5               # Default concurrent JS executions per tenant
# JS_SANDBOX_DEFAULT_TIMEOUT_MS=5000                # Default execution timeout
# JS_SANDBOX_MAX_TIMEOUT_MS=30000                   # Maximum execution timeout
# JS_SANDBOX_MEMORY_LIMIT_MB=64                     # V8 isolate memory limit
# JS_SANDBOX_MAX_CODE_SIZE_BYTES=65536              # Max submitted code size
# JS_SANDBOX_MAX_RESULT_SIZE_BYTES=524288           # Max serialized result size
# JS_SANDBOX_MAX_LOG_ENTRIES=100                    # Max captured console log entries
# JS_SANDBOX_CHILD_PROCESS_TIMEOUT_BUFFER_MS=1000   # Parent worker kill buffer after execution timeout

# ---- Cluster / Node Identity ---------------------------------
# Multi-node deployment. Default `all` keeps the single-node behaviour intact.
# NODE_ROLE=all                                     # main | worker | all
# NODE_NAME=                                        # Unique name (defaults to hostname-pid)
# NODE_URL=                                         # Public URL of this node (informational)
# NODE_TAGS=                                        # Comma-separated tags
# NODE_HEARTBEAT_MS=10000                           # Heartbeat write interval
# NODE_OFFLINE_AFTER_MS=30000                       # Mark node offline after this gap
# CLUSTER_DEFAULT_NODE_NAME=                        # Default node for new instance assignments

# ---- Job Queue -----------------------------------------------
# auto = bullmq when Redis is configured (REDIS_URL or QUEUE_REDIS_URL), else memory.
# QUEUE_PROVIDER=auto                               # auto | memory | bullmq
# QUEUE_REDIS_URL=                                  # Falls back to REDIS_URL
# QUEUE_PREFIX=console:q:                           # BullMQ key prefix
# QUEUE_DEFAULT_ATTEMPTS=3                          # Default retry attempts
# QUEUE_DEFAULT_BACKOFF_MS=1000                     # Default backoff between retries
#
# Crawl jobs run through this queue (async by default). With the memory
# provider a job in flight is lost on restart; the boot reconciler auto-restarts
# such interrupted crawls (bounded per job) so they recover on their own. Point
# QUEUE_REDIS_URL/REDIS_URL at Redis so BullMQ persists the job across restarts.
# CRAWLER_RESTART_ORPHANED_RUNS=true                # default true (bounded auto-restart of orphaned runs); set false to fail them for manual re-run instead
#
# Per-node consumer concurrency. These four used to be fixed at 1, which
# head-of-line blocked every cross-node job behind the slowest one until the
# queue's 60s invoke timeout failed the ones still waiting.
# AGENT_CHAT_CONCURRENCY=4                          # Concurrent agent turns per node
# MCP_INVOKE_CONCURRENCY=4                          # Concurrent MCP tool invocations per node
# BROWSER_ACTION_CONCURRENCY=4                      # Concurrent browser actions per node
# CRAWLER_RUN_CONCURRENCY=2                         # Concurrent crawl jobs per node (each fans out to ~16 fetches)
#
# ---- Agent Background Execution (docs/guide/agent-background-execution.md) ----
# AGENT_SYNC_TIMEOUT_MS=180000                      # Hard ceiling for a synchronous agent turn; MUST be below the shortest infra timeout in the deployment
# AGENT_BACKGROUND_MAX_DURATION_MS=1800000          # Server-operated upper bound on a background run, independent of the agent's own maxWallClockMs
# AGENT_BACKGROUND_MAX_CONCURRENT_RUNS_PER_TENANT=10 # Simple per-tenant cap on simultaneous queued+running background runs
# AGENT_RUN_RETENTION_DAYS=30                       # Retention TTL for AgentRun records (userMessage/result)
# AGENT_RUN_HEARTBEAT_INTERVAL_MS=15000             # How often a background worker writes heartbeatAt while running
# AGENT_RUN_HEARTBEAT_STALE_MS=45000                # A running run whose heartbeat is older than this is orphaned by the reconciler
# Per-project cap on queued+running background runs (0 = only the tenant cap)
AGENT_BACKGROUND_MAX_CONCURRENT_RUNS_PER_PROJECT=0
# Background runs executed at once per node (dedicated queue)
AGENT_RUN_CONCURRENCY=4
# Republish a queued run that no worker picked up after this long
AGENT_RUN_REQUEUE_AFTER_MS=120000
#
# Knowledge Engine ingest queue. Used when a client posts an ingest with
# `async: true`: the document is stored as `pending` and chunked + embedded by
# a job instead of inside the HTTP request.
# RAG_INGEST_CONCURRENCY=2                          # Documents indexed concurrently per node
# RAG_INGEST_BOOT_RESUME_MAX=500                    # Cap on pending documents re-published per boot sweep

# ---- Realtime voice engine (enterprise; docs: console-ee/docs/realtime/VOICE-ENGINE.md) ----
# Telephony (Twilio). Twilio reaches the webhooks over HTTPS and the media stream
# over WSS; X-Twilio-Signature is checked against this exact base URL.
# REALTIME_PUBLIC_URL=                              # Public base URL Twilio calls, e.g. https://abc.trycloudflare.com (default: APP_URL)
# REALTIME_STREAM_TOKEN_SECRET=                     # Key the Twilio media-stream tokens are encrypted + signed with (default: derived from JWT_SECRET)
# REALTIME_OUTBOUND_CALLS_PER_MINUTE=30             # Outbound calls per tenant per minute (0 = unlimited). Counted through RATE_LIMIT_PROVIDER, so it holds across nodes; a counter that cannot be read refuses the call (503)
# REALTIME_CALL_BLOCKED_PREFIXES=+1900,+979,+870,+881,+882,+883  # Destinations outbound calls may not dial (empty = none blocked)
# REALTIME_CALL_ALLOWED_PREFIXES=                   # When set, outbound calls may only dial these prefixes, e.g. +90,+44
# Turn-detection models (Silero VAD v5 — MIT, Smart Turn v3.2 — BSD-2-Clause): vendored in the
# enterprise overlay (models/realtime), baked into the image and sha256-verified. Never downloaded.
# REALTIME_MODELS_DIR=./models/realtime             # Where the bundled ONNX models live (Docker image: /app/models/realtime)
# REALTIME_SILERO_VAD_PATH=                         # Explicit Silero VAD .onnx file (used as-is, no checksum)
# REALTIME_SMART_TURN_PATH=                         # Explicit Smart Turn .onnx file for the selected variant (used as-is, no checksum)
# REALTIME_SMART_TURN_VARIANT=int8                  # int8 (8.7 MB quantized build, default) | fp32 (32 MB unquantized smart-turn-v3.2-gpu.onnx; no quantization noise; CPU cost is hardware-dependent — benchmark)
# REALTIME_PREWARM_MODELS=                          # 1 = load the models when the server starts (lowest first-call latency); default: the first session loads them, so a node nobody uses realtime on carries none
# REALTIME_MODEL_LOAD_TIMEOUT_MS=5000               # A session waits this long for the models, then starts degraded and swaps them in when they land
# REALTIME_ONNX_WORKERS=                            # Inference worker threads. Unset: starts with 2 and grows on demand up to max(2, cores - 2), at most 8 (~65 MB each); N fixes the pool at N; 0 = run in the main process
# REALTIME_SMART_TURN_THREADS=1                     # ONNX intra-op threads per Smart Turn call (1-8)
# Capacity. Every live session runs turn detection (Silero VAD windows 31x/s, a Smart Turn check at each
# pause) on the node's workers; past what the node can carry every call degrades together.
# REALTIME_MAX_SESSIONS=                            # Live sessions this node accepts (default: unlimited). At the cap a new WebSocket session is refused (error server_busy, close 1013), an inbound call gets <Reject reason="busy"/>, POST /calls answers 503. Rule of thumb: ~40 calls per ONNX worker
# Session limits.
# REALTIME_MAX_AUDIO_BYTES=26214400                 # Max buffered input audio per manual commit (bytes)
# REALTIME_MAX_FRAME_BYTES=1048576                  # Max WebSocket frame size on /api/client/v1/realtime (bytes, min 65536). ws assembles a whole frame of up to this size before authentication, so it bounds what an anonymous socket can pin
# REALTIME_MAX_PENDING_INPUT_BYTES=8388608          # Input one socket may have received but not processed yet (bytes); reading pauses at a quarter of it, the socket is dropped past it
# REALTIME_MAX_SOCKET_BUFFER_BYTES=8388608          # Output the server may have queued towards one client that is not reading (bytes); past it the client is dropped
# REALTIME_MAX_HISTORY=200                          # Conversation messages kept per session (oldest drop first)
# Session-log retention (call numbers, variables and transcripts live in realtime_sessions / realtime_session_turns).
# REALTIME_SESSION_RETENTION_DAYS=0                 # Delete sessions (and their turns) older than this many days; 0 = keep forever
# REALTIME_RETENTION_INTERVAL_SECONDS=3600          # How often the retention sweep runs (one pod at a time, via the cache lock)
